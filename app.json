{
  "expo": {
    "name": "AppFilter",
    "slug": "appfilter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.appfilter.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.appfilter.app",
      "newArchEnabled": false,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BIND_ACCESSIBILITY_SERVICE"
      ],
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f172a"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ]
    ],
    "extra": {
      "moderationApiEndpoint": "http://localhost:3001/api/moderate",
      "useLocalModeration": true,
      "eas": {
        "projectId": "ee284bb7-fd8d-4df9-a220-b4d91514ea06"
      }
    },
    "owner": "misa-misa.org"
  }
}
